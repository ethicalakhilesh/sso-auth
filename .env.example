# ES256 keypair used to sign/verify ID tokens. Generate with:
#   node scripts/generate-keys.mjs
# Keep AUTH_PRIVATE_KEY secret. AUTH_PUBLIC_KEY is safe to share (it's
# published via /.well-known/jwks.json for any client to verify tokens).
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=

# Identifies this provider in issued tokens and in the discovery document
# at /.well-known/openid-configuration. Use your real domain once deployed,
# e.g. https://auth.yourdomain.com
AUTH_ISSUER=http://localhost:3000

# Airtable — SSO base (Users, Clients, AuthCodes tables)
AIRTABLE_API_KEY=
AIRTABLE_SSO_BASE_ID=

# Optional: set to your domain (e.g. .yourdomain.com) once this app and
# Flow share a parent domain. Only affects sso-auth's own internal session
# cookie (used on this app's home page) — OIDC clients don't rely on this,
# they get their own token via /authorize + /api/oidc/token.
# Leave blank while testing locally / on separate Vercel domains.
COOKIE_DOMAIN=
